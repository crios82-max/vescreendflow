# Database
DATABASE_URL=postgres://ride:ride_secret@localhost:5436/ride_app

# API
PORT=4001
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176,https://ride-api.vescreenflow.com,https://ride.vescreenflow.com

# Pricing (USD per km / per minute)
PRICE_PER_KM=1.2
PRICE_PER_MIN=0.25
BASE_FARE=2.5

# Google Maps — habilita Maps JavaScript API + Places API + Directions API
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:4001
# Producción / TestFlight:
# VITE_API_URL=https://ride-api.vescreenflow.com
# EXPO_PUBLIC_API_URL=https://ride-api.vescreenflow.com
VITE_API_URL=http://localhost:4001

# Stripe (pagos + Connect payouts conductores)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=http://localhost:5175
STRIPE_CONNECT_RETURN_URL=http://localhost:5175
PLATFORM_FEE_PERCENT=25

# SMTP (recibos por email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ride@tudominio.com

# Twilio SMS (OTP teléfono) — sin esto usa mock (código 123456 en dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# URL pública del API (Twilio Voice) — producción:
# API_PUBLIC_URL=https://ride-api.vescreenflow.com
API_PUBLIC_URL=http://localhost:4001
OTP_EMAIL_FALLBACK=true

# Password reset, split fare y share links
PASSENGER_WEB_URL=http://localhost:5174
# Producción: https://ride.vescreenflow.com

# Requiere teléfono verificado para pedir viaje (false solo en dev)
REQUIRE_PHONE_VERIFY=true
