{
  "name": "screenflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix server",
    "senseflow:dev": "npm run dev --prefix senseflow/server",
    "senseflow:seed": "npm run seed --prefix senseflow/server",
    "senseflow:smoke": "senseflow/scripts/smoke.sh",
    "veplayer:obd-smoke": "node veplayer/scripts/obd-pid-smoke.mjs",
    "veplayer:can-smoke": "node veplayer/scripts/can-smoke.mjs",
    "veplayer:kiosk-smoke": "node veplayer/scripts/kiosk-smoke.mjs",
    "veplayer:field-smoke": "node veplayer/scripts/field-smoke.mjs",
    "veplayer:ota-smoke": "node veplayer/scripts/ota-smoke.mjs",
    "veplayer:dbc-smoke": "node veplayer/scripts/dbc-smoke.mjs",
    "veplayer:fm-smoke": "node veplayer/scripts/fm-smoke.mjs",
    "veplayer:nav-map-smoke": "node veplayer/scripts/nav-map-smoke.mjs",
    "veplayer:fleet-ops-smoke": "node veplayer/scripts/fleet-ops-smoke.mjs",
    "veplayer:fleet-auth-smoke": "node veplayer/scripts/fleet-auth-smoke.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "tsc -b && vite build",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=vescreenflow",
    "tunnel": "cloudflared tunnel --config cloudflared/config.yml run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.86.0"
  }
}
