    "veplayer:parking-hud-smoke": "node veplayer/scripts/parking-hud-smoke.mjs",
    "veplayer:door-ajar-smoke": "node veplayer/scripts/door-ajar-smoke.mjs",
    "veplayer:shift-fatigue-smoke": "node veplayer/scripts/shift-fatigue-smoke.mjs",
    "veplayer:hvac-climate-smoke": "node veplayer/scripts/hvac-climate-smoke.mjs",
    "veplayer:nav-tts-smoke": "node veplayer/scripts/nav-tts-smoke.mjs",
    "veplayer:reverse-guides-smoke": "node veplayer/scripts/reverse-guides-smoke.mjs",
    "veplayer:fleet-csv-smoke": "node veplayer/scripts/fleet-csv-smoke.mjs",
    "veplayer:driver-smoke": "node veplayer/scripts/driver-smoke.mjs",
    "veplayer:fleet-inbox-smoke": "node veplayer/scripts/fleet-inbox-smoke.mjs",
    "veplayer:shift-smoke": "node veplayer/scripts/shift-smoke.mjs",
    "veplayer:speed-hud-smoke": "node veplayer/scripts/speed-hud-smoke.mjs",
    "veplayer:crowd-map-smoke": "node veplayer/scripts/crowd-map-smoke.mjs",
    "veplayer:maintenance-smoke": "node veplayer/scripts/maintenance-smoke.mjs",
    "veplayer:fuel-hud-smoke": "node veplayer/scripts/fuel-hud-smoke.mjs",
    "veplayer:idle-alert-smoke": "node veplayer/scripts/idle-alert-smoke.mjs",
    "veplayer:panic-sos-smoke": "node veplayer/scripts/panic-sos-smoke.mjs",
    "veplayer:fleet-map-smoke": "node veplayer/scripts/fleet-map-smoke.mjs",
    "veplayer:geofence-speed-smoke": "node veplayer/scripts/geofence-speed-smoke.mjs",
    "veplayer:fleet-ops-smoke": "node veplayer/scripts/fleet-ops-smoke.mjs",
    "veplayer:fleet-auth-smoke": "node veplayer/scripts/fleet-auth-smoke.mjs",
